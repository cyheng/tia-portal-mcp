<Project Sdk="Microsoft.NET.Sdk">
  <!--
    离线回归检查通过源文件链接执行与主服务共用的独立逻辑。
    入口为控制台程序，使用 dotnet run；CI 采用同一条执行命令。
    TIA 会话的集成验证由安装了 V21 Openness 的环境完成。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\TiaMcpServer\CliOptions.cs" Link="CliOptions.cs" />
    <Compile Include="..\..\src\TiaMcpServer\Cli\McpConfigInstaller.cs" Link="McpConfigInstaller.cs" />
    <Compile Include="..\..\src\TiaMcpServer\Cli\SpecLoader.cs" Link="SpecLoader.cs" />
    <Compile Include="..\..\src\TiaMcpServer\Siemens\ProjectFilePath.cs" Link="ProjectFilePath.cs" />
    <Compile Include="..\..\src\TiaMcpServer\Siemens\Engineering.cs" Link="Engineering.cs" />
    <Compile Include="..\..\src\TiaMcpServer\Siemens\Capability.cs" Link="Capability.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\Responses.Workflow.cs" Link="Responses.Workflow.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ProjectSpecification.cs" Link="ProjectSpecification.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ProjectWorkflow.cs" Link="ProjectWorkflow.cs" />
    <!-- HMI 布局与执行 JSON 校验共用实际构建器，覆盖正确输入和失败输入。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\HmiTemplateLayoutAnalyzer.cs" Link="HmiTemplateLayoutAnalyzer.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\HmiTemplateDesignJsonBuilder.cs" Link="HmiTemplateDesignJsonBuilder.cs" />
    <!-- 资源扫描、参数诊断、响应分页和进程失败分类使用独立实现。 -->
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\S7ResScanner.cs" Link="S7ResScanner.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ArgDiagnostics.cs" Link="ArgDiagnostics.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\ExportStore.cs" Link="ExportStore.cs" />
    <Compile Include="..\..\src\TiaMcpServer\ModelContextProtocol\PortalFailureClassifier.cs" Link="PortalFailureClassifier.cs" />
  </ItemGroup>
</Project>
